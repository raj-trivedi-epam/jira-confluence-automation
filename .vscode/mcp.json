{
  "servers": {
    "echo": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/mcp_echo_server.py"
      ]
    },
    "text_stats": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/mcp_text_stats_server.py"
      ]
    },
    "github": { 
      "type": "http", 
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "source \"$HOME/.nvm/nvm.sh\" && exec npx -y chrome-devtools-mcp@latest --channel stable --isolated"
      ]
    }
  }
}
