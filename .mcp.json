{
  "mcpServers": {
    "echo": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "tools/mcp_echo_server.py"
      ]
    },
    "text_stats": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "tools/mcp_text_stats_server.py"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "source \"$HOME/.nvm/nvm.sh\" && exec npx -y chrome-devtools-mcp@latest --channel stable --isolated"
      ]
    }
  }
}
